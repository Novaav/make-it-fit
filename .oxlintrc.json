{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "no-console": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "playwright-report",
    "test-results",
    "art-review"
  ],
  "overrides": [
    {
      "files": [
        "e2e/**",
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
